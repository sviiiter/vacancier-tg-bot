# Telegram
BOT_TOKEN=123456789:AABBccDDeeFFggHH
CHAT_ID=-1001234567890

# Database
DB_DRIVER=sqlite          # sqlite | postgres | mysql
DB_DSN=./messages.db      # file path for sqlite, connection URL for postgres/mysql
# DB_DSN=postgres://user:pass@localhost:5432/dbname
# DB_DSN=mysql://user:pass@localhost:3306/dbname

# Tuning
BATCH_SIZE=10
POLL_INTERVAL_SEC=60
SEND_DELAY_SEC=0.5
